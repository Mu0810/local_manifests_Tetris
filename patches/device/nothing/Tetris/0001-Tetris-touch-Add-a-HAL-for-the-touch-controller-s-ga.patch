diff --git a/touch/HighTouchPollingRate.cpp b/touch/HighTouchPollingRate.cpp
new file mode 100644
index 0000000..070b0ba
--- /dev/null
+++ b/touch/HighTouchPollingRate.cpp
@@ -0,0 +1,154 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#define LOG_TAG "vendor.lineage.touch-service.tetris"
+
+#include "HighTouchPollingRate.h"
+
+#include <android-base/file.h>
+#include <android-base/logging.h>
+#include <android-base/properties.h>
+#include <sys/system_properties.h>
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <string_view>
+#include <thread>
+
+using ::android::base::GetProperty;
+using ::android::base::ReadFileToString;
+using ::android::base::WaitForPropertyCreation;
+using ::android::base::WriteStringToFile;
+
+using namespace std::chrono_literals;
+
+namespace aidl {
+namespace vendor {
+namespace lineage {
+namespace touch {
+
+namespace {
+
+constexpr const char* kGameModePath = "/proc/touchpanel/game_mode";
+// The first line of the node is the driver's own flag, "Game Mode:On" or "Game Mode:Off".
+constexpr const char* kFlagOn = "Game Mode:On";
+
+// Set by DisplayPowerController on every display state change. "2" is Display.STATE_ON.
+constexpr const char* kScreenStateProp = "debug.tracing.screen_state";
+constexpr const char* kScreenOn = "2";
+
+// When the screen turns on, the driver resets the controller (fts_ts_resume ->
+// fts_reset_proc) and does not turn game mode back on: fts_ex_mode_recovery only
+// restores glove, cover and charger mode. The reset lands a little after the
+// property changes, so check at these times after screen-on and write again
+// whenever game mode has been lost.
+constexpr std::chrono::milliseconds kRestoreChecks[] = {300ms,  600ms,  1000ms,
+                                                        1500ms, 2000ms, 3000ms};
+
+// Reading the node returns "Game Mode:On\nReg(0x90)=1\nReg(0x93)=1\n": the driver's
+// flag, then the controller's game mode register (0x90) and the register the driver
+// calls FPS_1000HZ_EN (0x93). Returns the value of register 0x90, or -1.
+int gameModeRegister(const std::string& node) {
+    constexpr std::string_view kKey = "Reg(0x90)=";
+    const size_t pos = node.find(kKey);
+    int value = -1;
+    if (pos == std::string::npos ||
+        std::sscanf(node.c_str() + pos + kKey.size(), "%d", &value) != 1) {
+        return -1;
+    }
+    return value;
+}
+
+}  // namespace
+
+HighTouchPollingRate::HighTouchPollingRate() {
+    std::string node;
+    if (!ReadFileToString(kGameModePath, &node)) {
+        PLOG(ERROR) << "Failed to read " << kGameModePath;
+        return;
+    }
+    mEnabled = node.find(kFlagOn) != std::string::npos;
+}
+
+ndk::ScopedAStatus HighTouchPollingRate::getEnabled(bool* _aidl_return) {
+    std::lock_guard<std::mutex> lock(mLock);
+    *_aidl_return = mEnabled;
+    return ndk::ScopedAStatus::ok();
+}
+
+ndk::ScopedAStatus HighTouchPollingRate::setEnabled(bool enabled) {
+    std::lock_guard<std::mutex> lock(mLock);
+    mEnabled = enabled;
+    if (!enabled) {
+        // system_server applies the saved setting at every boot, so this is called with false
+        // even when the switch was never used. Only undo what was turned on, so that otherwise
+        // the controller keeps its own defaults, as on stock.
+        std::string node;
+        if (ReadFileToString(kGameModePath, &node) && node.find(kFlagOn) == std::string::npos) {
+            return ndk::ScopedAStatus::ok();
+        }
+    }
+    if (!WriteStringToFile(enabled ? "1" : "0", kGameModePath)) {
+        PLOG(ERROR) << "Failed to write " << kGameModePath;
+        return ndk::ScopedAStatus::fromExceptionCode(EX_UNSUPPORTED_OPERATION);
+    }
+    return ndk::ScopedAStatus::ok();
+}
+
+void HighTouchPollingRate::watchScreenState() {
+    // system_server creates the property at the first display state change after boot.
+    if (!WaitForPropertyCreation(kScreenStateProp, 2min)) {
+        LOG(WARNING) << "Still waiting for " << kScreenStateProp
+                     << ": until it appears, game mode will not survive the screen turning off";
+        WaitForPropertyCreation(kScreenStateProp);
+    }
+    const prop_info* pi = __system_property_find(kScreenStateProp);
+    if (pi == nullptr) {
+        LOG(ERROR) << "Failed to find " << kScreenStateProp;
+        return;
+    }
+
+    uint32_t serial = 0;
+    while (true) {
+        uint32_t newSerial = 0;
+        if (!__system_property_wait(pi, serial, &newSerial, nullptr)) continue;
+        serial = newSerial;
+        if (GetProperty(kScreenStateProp, "") == kScreenOn) restoreAfterScreenOn();
+    }
+}
+
+void HighTouchPollingRate::restoreAfterScreenOn() {
+    {
+        std::lock_guard<std::mutex> lock(mLock);
+        if (!mEnabled) return;
+    }
+    std::chrono::milliseconds elapsed = 0ms;
+    for (const auto check : kRestoreChecks) {
+        std::this_thread::sleep_for(check - elapsed);
+        elapsed = check;
+        // Stop if the screen turned off again; the next screen-on starts over.
+        if (GetProperty(kScreenStateProp, "") != kScreenOn) return;
+
+        std::lock_guard<std::mutex> lock(mLock);
+        if (!mEnabled) return;
+        std::string node;
+        if (!ReadFileToString(kGameModePath, &node)) return;  // setEnabled() logged why.
+        const int reg = gameModeRegister(node);
+        // Still on: keep checking, the reset may not have happened yet.
+        if (reg == 1) continue;
+        if (!WriteStringToFile("1", kGameModePath)) {
+            PLOG(ERROR) << "Failed to turn game mode back on";
+            return;
+        }
+        if (reg == 0) LOG(INFO) << "Turned game mode back on after screen-on";
+    }
+}
+
+}  // namespace touch
+}  // namespace lineage
+}  // namespace vendor
+}  // namespace aidl
diff --git a/touch/HighTouchPollingRate.h b/touch/HighTouchPollingRate.h
new file mode 100644
index 0000000..45773d1
--- /dev/null
+++ b/touch/HighTouchPollingRate.h
@@ -0,0 +1,38 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+#include <aidl/vendor/lineage/touch/BnHighTouchPollingRate.h>
+
+#include <mutex>
+
+namespace aidl {
+namespace vendor {
+namespace lineage {
+namespace touch {
+
+// Drives the FocalTech touch driver's game mode (/proc/touchpanel/game_mode).
+class HighTouchPollingRate : public BnHighTouchPollingRate {
+  public:
+    HighTouchPollingRate();
+
+    ndk::ScopedAStatus getEnabled(bool* _aidl_return) override;
+    ndk::ScopedAStatus setEnabled(bool enabled) override;
+
+    // Never returns. Turns game mode back on after the screen turns on.
+    void watchScreenState();
+
+  private:
+    void restoreAfterScreenOn();
+
+    std::mutex mLock;
+    bool mEnabled = false;  // Guarded by mLock.
+};
+
+}  // namespace touch
+}  // namespace lineage
+}  // namespace vendor
+}  // namespace aidl
diff --git a/touch/service.cpp b/touch/service.cpp
new file mode 100644
index 0000000..3c64089
--- /dev/null
+++ b/touch/service.cpp
@@ -0,0 +1,33 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#define LOG_TAG "vendor.lineage.touch-service.tetris"
+
+#include "HighTouchPollingRate.h"
+
+#include <android-base/logging.h>
+#include <android/binder_manager.h>
+#include <android/binder_process.h>
+
+#include <cstdlib>
+#include <memory>
+#include <string>
+#include <thread>
+
+using aidl::vendor::lineage::touch::HighTouchPollingRate;
+
+int main() {
+    ABinderProcess_setThreadPoolMaxThreadCount(0);
+
+    std::shared_ptr<HighTouchPollingRate> htpr = ndk::SharedRefBase::make<HighTouchPollingRate>();
+    const std::string instance = std::string(HighTouchPollingRate::descriptor) + "/default";
+    binder_status_t status = AServiceManager_addService(htpr->asBinder().get(), instance.c_str());
+    CHECK_EQ(status, STATUS_OK) << "Failed to add service " << instance << " " << status;
+
+    std::thread(&HighTouchPollingRate::watchScreenState, htpr).detach();
+
+    ABinderProcess_joinThreadPool();
+    return EXIT_FAILURE;  // should not reach
+}
